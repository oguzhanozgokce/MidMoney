#!/bin/sh
# Runs formatting + static analysis before every commit.
# Enable once with: ./gradlew installGitHooks   (or: git config core.hooksPath .githooks)

echo "pre-commit: running ktlintCheck + detekt..."

./gradlew --quiet ktlintCheck detekt
status=$?

if [ $status -ne 0 ]; then
  echo ""
  echo "pre-commit failed. Fix issues (try ./gradlew ktlintFormat) and commit again."
  exit $status
fi

echo "pre-commit: OK"
exit 0
